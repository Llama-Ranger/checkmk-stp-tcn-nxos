#!/usr/bin/env python3
# Cisco Nexus STP topology change monitoring for Checkmk (nxos_stp_tcn)
# Copyright (C) 2026 John Jimenez & Cledir Justo
# SPDX-License-Identifier: GPL-2.0-or-later
"""Checkmk special agent: Cisco Nexus spanning-tree topology changes per VLAN (SNMPv3).

Part of the nxos_stp_tcn extension.

For every VLAN the switch reports in CISCO-CONTEXT-MAPPING-MIB, the BRIDGE-MIB scalars
dot1dStpTopChanges and dot1dStpTimeSinceTopologyChange are read in the VLAN's numeric
SNMPv3 context (e.g. context "200" for VLAN 200). The "vlan-<id>" contexts are not used:
on NX-OS 10.2(5) they were proven to return another VLAN's data for VLANs created after boot.

Credentials are resolved from the Checkmk password store and handed to Net-SNMP through a
private temporary snmp.conf (SNMPCONFPATH), so they never appear on a command line.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable, Iterator, Mapping, Sequence
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path

__version__ = "3.0.0"

SECTION_NAME = "nxos_stp_tcn"

OID_CONTEXT_VLAN = ".1.3.6.1.4.1.9.9.468.1.5.1.2"  # CISCO-CONTEXT-MAPPING-MIB: context -> VLAN
OID_SYS_UPTIME = ".1.3.6.1.2.1.1.3.0"
OID_TIME_SINCE_TC = ".1.3.6.1.2.1.17.2.3.0"  # BRIDGE-MIB dot1dStpTimeSinceTopologyChange
OID_TOP_CHANGES = ".1.3.6.1.2.1.17.2.4.0"  # BRIDGE-MIB dot1dStpTopChanges

AUTH_PROTOCOLS = {
    "md5": "MD5",
    "sha": "SHA",
    "sha224": "SHA-224",
    "sha256": "SHA-256",
    "sha384": "SHA-384",
    "sha512": "SHA-512",
}
PRIV_PROTOCOLS = {
    "des": "DES",
    "aes": "AES",
    "aes192": "AES192",
    "aes256": "AES256",
    "aes192c": "AES192C",
    "aes256c": "AES256C",
}

Runner = Callable[[Sequence[str], Mapping[str, str]], "subprocess.CompletedProcess[str]"]


class CollectorError(Exception):
    """Failure that prevents any useful output for the whole host."""


@dataclass(frozen=True)
class Credentials:
    user: str
    security_level: str  # "authPriv" | "authNoPriv"
    auth_type: str
    auth_passphrase: str
    priv_type: str | None = None
    priv_passphrase: str | None = None

    def __repr__(self) -> str:  # never render passphrases
        return f"Credentials(user={self.user!r}, security_level={self.security_level!r})"


@dataclass(frozen=True)
class QueryConfig:
    host: str
    port: int = 161
    timeout: int = 2
    retries: int = 1
    workers: int = 4

    @property
    def target(self) -> str:
        if ":" in self.host:
            return f"udp6:[{self.host}]:{self.port}"
        return f"udp:{self.host}:{self.port}"


@dataclass(frozen=True)
class SnmpValue:
    status: str  # "ok" | "nosuch" | "timeout" | "error"
    value: str | None = None


# --------------------------------------------------------------------------------------------
# Password store (Checkmk 2.5 public-but-unstable API, 2.3/2.4 internal API)
# --------------------------------------------------------------------------------------------


class PasswordLookupError(Exception):
    pass


def resolve_secret(reference: str) -> str:
    """Resolve a "<password id>:<password store file>" reference passed by Checkmk."""
    password_id = reference.split(":", 1)[0]
    try:
        try:
            from cmk.password_store.v1_unstable import dereference_secret  # Checkmk 2.5
        except ImportError:
            from cmk.utils import password_store  # Checkmk 2.3 and 2.4

            pw_id, pw_file = reference.split(":", 1)
            return password_store.lookup(Path(pw_file), pw_id)
        return dereference_secret(reference).reveal()
    except Exception as exc:  # noqa: BLE001 - its text is not trusted to be free of secrets
        raise PasswordLookupError(
            f"Cannot read password {password_id!r} from the Checkmk password store"
            f" ({type(exc).__name__})"
        ) from None


# --------------------------------------------------------------------------------------------
# Net-SNMP configuration
# --------------------------------------------------------------------------------------------


def _conf_quote(value: str) -> str:
    if any(char in value for char in "\r\n\0"):
        raise ValueError("SNMP settings must not contain line breaks")
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render_snmp_conf(creds: Credentials, persistent_dir: str) -> str:
    lines = [
        f"defSecurityName {_conf_quote(creds.user)}",
        f"defSecurityLevel {creds.security_level}",
        f"defAuthType {creds.auth_type}",
        f"defAuthPassphrase {_conf_quote(creds.auth_passphrase)}",
    ]
    if creds.security_level == "authPriv":
        if not (creds.priv_type and creds.priv_passphrase):
            raise ValueError("authPriv requires a privacy protocol and passphrase")
        lines += [
            f"defPrivType {creds.priv_type}",
            f"defPrivPassphrase {_conf_quote(creds.priv_passphrase)}",
        ]
    lines += [
        f"persistentDir {persistent_dir}",
        "noPersistentLoad yes",
        "noPersistentSave yes",
    ]
    return "\n".join(lines) + "\n"


@contextmanager
def private_snmp_environment(creds: Credentials) -> Iterator[dict[str, str]]:
    """Yield an environment whose SNMPCONFPATH points to a private, temporary snmp.conf."""
    tmpdir = tempfile.mkdtemp(prefix="nxos_stp_tcn_")  # created with mode 0700
    try:
        conf = Path(tmpdir, "snmp.conf")
        fd = os.open(conf, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(render_snmp_conf(creds, tmpdir))
        yield {**os.environ, "SNMPCONFPATH": tmpdir}
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


# --------------------------------------------------------------------------------------------
# SNMP queries
# --------------------------------------------------------------------------------------------


def snmp_command(tool: str, cfg: QueryConfig, oid: str, context: str | None = None) -> list[str]:
    command = [shutil.which(tool) or tool, "-v3", "-On", "-Ot", "-Ox"]
    command += ["-t", str(cfg.timeout), "-r", str(cfg.retries)]
    if context is not None:
        command += ["-n", context]
    return [*command, cfg.target, oid]


def run_command(command: Sequence[str], env: Mapping[str, str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(command), env=dict(env), capture_output=True, text=True, check=False, timeout=120
    )


def _first_line(text: str) -> str:
    return (text.strip().splitlines() or [""])[0][:200]


_GET_VALUE = re.compile(r"=\s*(?:[A-Za-z0-9-]+:\s*)?\(?(\d+)\)?")


def parse_get(proc: subprocess.CompletedProcess[str]) -> SnmpValue:
    """Interpret the output of a single-OID snmpget."""
    text = f"{proc.stdout}\n{proc.stderr}"
    if "No Such" in text:  # noSuchObject / noSuchInstance
        return SnmpValue("nosuch")
    if proc.returncode != 0 or not proc.stdout.strip():
        return SnmpValue("timeout" if "Timeout" in proc.stderr else "error")
    if match := _GET_VALUE.search(proc.stdout):
        return SnmpValue("ok", match.group(1))
    return SnmpValue("error")


_CONTEXT_ROW = re.compile(
    r"^\.?1\.3\.6\.1\.4\.1\.9\.9\.468\.1\.5\.1\.2\.([\d.]+)\s*=\s*"
    r"(?:Hex-STRING:\s*)?\"?([0-9A-Fa-f][0-9A-Fa-f ]*?)\s*\"?\s*$"
)


def parse_context_map(walk_output: str) -> dict[str, int]:
    """Decode CISCO-CONTEXT-MAPPING-MIB rows into {context name: VLAN ID}.

    The row index is the length-prefixed context name (plus one more sub-identifier);
    the value is the VLAN ID as a 4-byte little-endian octet string ("C8 00 00 00" = 200).
    """
    contexts: dict[str, int] = {}
    for line in walk_output.splitlines():
        if not (match := _CONTEXT_ROW.match(line.strip())):
            continue
        index = [int(part) for part in match.group(1).split(".")]
        if not index or len(index) < index[0] + 1:
            continue
        try:
            name = bytes(index[1 : 1 + index[0]]).decode("ascii")
            raw = bytes.fromhex(match.group(2))
        except ValueError:
            continue
        if 0 < len(raw) <= 4:
            contexts[name] = int.from_bytes(raw, "little")
    return contexts


def numeric_vlan_contexts(contexts: Mapping[str, int]) -> list[int]:
    """VLAN IDs that have a numeric context whose name equals the VLAN ID."""
    return sorted(
        vlan for name, vlan in contexts.items() if name == str(vlan) and 1 <= vlan <= 4094
    )


def query_vlan(vlan: int, cfg: QueryConfig, env: Mapping[str, str], runner: Runner) -> str:
    context = str(vlan)
    changes = parse_get(runner(snmp_command("snmpget", cfg, OID_TOP_CHANGES, context), env))
    if changes.status != "ok":
        return f"vlan;{vlan};{changes.status};;"
    since = parse_get(runner(snmp_command("snmpget", cfg, OID_TIME_SINCE_TC, context), env))
    if since.status != "ok":
        return f"vlan;{vlan};{since.status};{changes.value};"
    return f"vlan;{vlan};ok;{changes.value};{since.value}"


def collect(
    cfg: QueryConfig,
    env: Mapping[str, str],
    runner: Runner = run_command,
    now: float | None = None,
) -> list[str]:
    """The section body: when it was collected, the switch uptime, one line per VLAN."""
    now = time.time() if now is None else now
    walk = runner(snmp_command("snmpwalk", cfg, OID_CONTEXT_VLAN), env)
    if walk.returncode != 0:
        raise CollectorError(f"Cannot read the VLAN context table: {_first_line(walk.stderr)}")
    vlans = numeric_vlan_contexts(parse_context_map(walk.stdout))
    if not vlans:
        raise CollectorError(
            "The switch reports no numeric VLAN contexts (CISCO-CONTEXT-MAPPING-MIB)"
        )

    uptime = parse_get(runner(snmp_command("snmpget", cfg, OID_SYS_UPTIME), env))
    lines = [
        f"collected;{int(now)}",
        f"sysuptime;{uptime.value if uptime.status == 'ok' else ''}",
    ]
    with ThreadPoolExecutor(max_workers=max(1, cfg.workers)) as pool:
        lines.extend(pool.map(lambda vlan: query_vlan(vlan, cfg, env, runner), vlans))
    return lines


# --------------------------------------------------------------------------------------------
# Cache
#
# One switch with 79 VLANs costs ~160 SNMP requests and half a minute. The Checkmk service
# that runs this agent also fetches every other data source of the host, so slowing that
# service down would slow the host's SNMP checks down with it. Instead the agent keeps its own
# answer: it re-serves the stored lines until they reach the configured age, and only then
# talks to the switch again. Nothing else about the host is affected.
#
# The file holds the section body of one host, no credentials.
# --------------------------------------------------------------------------------------------


def section_header(collected_at: int | None = None, cache_age: int = 0) -> str:
    """The section line, telling Checkmk how old the data is when it is cached.

    ``cached(<collection time>,<validity>)`` is what stops Checkmk from treating the repeated
    lines as fresh measurements, and what keeps the service from going stale between two real
    collections.
    """
    options = ["sep(59)"]
    if cache_age > 0 and collected_at is not None:
        options.append(f"cached({collected_at},{cache_age})")
    return f"<<<{SECTION_NAME}:{':'.join(options)}>>>"


def cache_file(host: str) -> Path:
    directory = (
        Path(root, "tmp", "check_mk", "cache")
        if (root := os.environ.get("OMD_ROOT"))
        else Path(tempfile.gettempdir())
    )
    return directory / f"{SECTION_NAME}.{re.sub(r'[^A-Za-z0-9_.-]', '_', host)}"


def collected_at(lines: Sequence[str]) -> int | None:
    for line in lines:
        if line.startswith("collected;"):
            try:
                return int(line.split(";", 1)[1])
            except ValueError:
                return None
    return None


def read_cache(path: Path, max_age: int, now: float) -> list[str] | None:
    """The stored body if it is still young enough, None if it is missing, old or unreadable."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None
    written = collected_at(lines)
    if written is None:
        return None
    # A file from the future - the clock was set back - is discarded rather than trusted.
    return lines if 0 <= now - written < max_age else None


def write_cache(path: Path, lines: Sequence[str]) -> None:
    """Replace the cache file atomically, so a parallel run never reads half of it."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f"{path.name}.")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                handle.write("\n".join(lines) + "\n")
            os.chmod(temporary, 0o600)
            os.replace(temporary, path)
        except OSError:
            Path(temporary).unlink(missing_ok=True)
            raise
    except OSError:
        pass  # a cache that cannot be written is not a reason to fail the run


# --------------------------------------------------------------------------------------------
# Command line
# --------------------------------------------------------------------------------------------


def parse_arguments(argv: Sequence[str] | None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Cisco Nexus STP topology changes per VLAN")
    parser.add_argument("--host", required=True, help="IP address of the switch")
    parser.add_argument("--port", type=int, default=161)
    parser.add_argument("--user", required=True, help="SNMPv3 security name")
    parser.add_argument("--security-level", choices=("authPriv", "authNoPriv"), default="authPriv")
    parser.add_argument("--auth-protocol", choices=sorted(AUTH_PROTOCOLS), required=True)
    parser.add_argument(
        "--auth-password-id", required=True, help="Password store reference <id>:<file>"
    )
    parser.add_argument("--priv-protocol", choices=sorted(PRIV_PROTOCOLS))
    parser.add_argument("--priv-password-id", help="Password store reference <id>:<file>")
    parser.add_argument("--timeout", type=int, default=2, help="Seconds per SNMP request")
    parser.add_argument("--retries", type=int, default=1)
    parser.add_argument("--workers", type=int, default=4, help="VLAN contexts queried in parallel")
    parser.add_argument(
        "--cache-age",
        type=int,
        default=0,
        metavar="SECONDS",
        help="Re-serve the last answer for this long instead of querying the switch (0: never)",
    )
    parser.add_argument("--debug", action="store_true", help="Show Python tracebacks")
    return parser.parse_args(argv)


def credentials_from_args(args: argparse.Namespace) -> Credentials:
    if args.security_level == "authPriv":
        if not (args.priv_protocol and args.priv_password_id):
            raise ValueError("authPriv requires --priv-protocol and --priv-password-id")
        return Credentials(
            user=args.user,
            security_level="authPriv",
            auth_type=AUTH_PROTOCOLS[args.auth_protocol],
            auth_passphrase=resolve_secret(args.auth_password_id),
            priv_type=PRIV_PROTOCOLS[args.priv_protocol],
            priv_passphrase=resolve_secret(args.priv_password_id),
        )
    return Credentials(
        user=args.user,
        security_level="authNoPriv",
        auth_type=AUTH_PROTOCOLS[args.auth_protocol],
        auth_passphrase=resolve_secret(args.auth_password_id),
    )


def main(argv: Sequence[str] | None = None, runner: Runner = run_command) -> int:
    args = parse_arguments(argv)
    cfg = QueryConfig(
        host=args.host,
        port=args.port,
        timeout=args.timeout,
        retries=args.retries,
        workers=args.workers,
    )
    cache = cache_file(cfg.host) if args.cache_age > 0 else None

    if cache is not None and (lines := read_cache(cache, args.cache_age, time.time())) is not None:
        _write_section(lines, args.cache_age)
        return 0

    try:
        creds = credentials_from_args(args)
        with private_snmp_environment(creds) as env:
            lines = collect(cfg, env, runner)
    except (
        CollectorError,
        PasswordLookupError,
        ValueError,
        OSError,
        subprocess.SubprocessError,
    ) as exc:
        if args.debug:
            raise
        sys.stderr.write(f"agent_nxos_stp_tcn: {exc}\n")
        return 1

    if cache is not None:
        write_cache(cache, lines)
    _write_section(lines, args.cache_age)
    return 0


def _write_section(lines: Sequence[str], cache_age: int) -> None:
    sys.stdout.write("\n".join([section_header(collected_at(lines), cache_age), *lines]) + "\n")


if __name__ == "__main__":
    sys.exit(main())
